// Pocket Patch (simple) - works with 3 inputs: itemName, storeName, fixedTotal
const STORAGE_KEY = "pocketPatch_purchases_simple_v1";

const form = document.getElementById("purchaseForm");
const itemNameEl = document.getElementById("itemName");
const storeNameEl = document.getElementById("storeName");
const fixedTotalEl = document.getElementById("fixedTotal");

const listEl = document.getElementById("purchaseList");
const totalSpentEl = document.getElementById("totalSpent");

function money(n) {
  const num = Number(n);
  if (!Number.isFinite(num)) return "$0.00";
  return num.toLocaleString(undefined, { style: "currency", currency: "USD" });
}

function loadPurchases() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    return raw ? JSON.parse(raw) : [];
  } catch {
    return [];
  }
}

function savePurchases(purchases) {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(purchases));
}

function makeId() {
  return `${Date.now()}_${Math.random().toString(16).slice(2)}`;
}

function escapeHTML(str) {
  return String(str)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function render() {
  const purchases = loadPurchases();

  // total spent
  const total = purchases.reduce((sum, p) => sum + (Number(p.price) || 0), 0);
  totalSpentEl.textContent = `Total spent: ${money(total)}`;

  // list
  if (purchases.length === 0) {
    listEl.innerHTML = "";
    return;
  }

  listEl.innerHTML = purchases
    .slice()
    .reverse()
    .map(
      (p) => `
      <div style="margin-top:10px; padding:10px; border:1px solid rgba(255,255,255,.12); border-radius:12px;">
        <div><b>${escapeHTML(p.item)}</b> — ${escapeHTML(p.store)}</div>
        <div>${money(p.price)}</div>
      </div>
    `
    )
    .join("");
}

form.addEventListener("submit", (e) => {
  e.preventDefault();

  const item = itemNameEl.value.trim();
  const store = storeNameEl.value.trim();
  const price = Number(fixedTotalEl.value);

  if (!item || !store) {
    alert("Enter item and store.");
    return;
  }
  if (!Number.isFinite(price) || price <= 0) {
    alert("Enter a valid price.");
    return;
  }

  const purchases = loadPurchases();
  purchases.push({ id: makeId(), item, store, price: Number(price.toFixed(2)) });
  savePurchases(purchases);

  // clear inputs
  itemNameEl.value = "";
  storeNameEl.value = "";
  fixedTotalEl.value = "";

  render();
});

render();
